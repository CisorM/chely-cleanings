# Copy to `.env` and fill in. Vars prefixed PUBLIC_ are exposed to the browser.

# --- BookingKoala -------------------------------------------------------------
# Your BookingKoala account subdomain: <subdomain>.bookingkoala.com
PUBLIC_BOOKINGKOALA_SUBDOMAIN=

# --- Analytics -------------------------------------------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (leave empty to disable)
PUBLIC_GA_ID=

# --- Maps -------------------------------------------------------------
# Full "src" URL from a Google Maps "Embed a map" iframe (optional)
PUBLIC_GOOGLE_MAPS_EMBED=

# --- Server-only integrations (no PUBLIC_ prefix) ---------------------------
# Add keys for contact-form providers, CRM webhooks, etc. here as needed.
# CONTACT_FORM_ENDPOINT=

# Copy to `.env` and fill in. Vars prefixed PUBLIC_ are exposed to the browser.

# --- BookingKoala -------------------------------------------------------------
# Your BookingKoala account subdomain: <subdomain>.bookingkoala.com
PUBLIC_BOOKINGKOALA_SUBDOMAIN=

# --- Analytics -------------------------------------------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (leave empty to disable)
PUBLIC_GA_ID=

# --- Maps -------------------------------------------------------------
# Full "src" URL from a Google Maps "Embed a map" iframe (optional)
PUBLIC_GOOGLE_MAPS_EMBED=

# --- Server-only integrations (no PUBLIC_ prefix) ---------------------------
# Contact form → email, sent via Resend (https://resend.com) from the
# /api/contact endpoint. Set these in the Vercel project env as well.
RESEND_API_KEY=
# Where form submissions are delivered.
CONTACT_TO_EMAIL=services@chelycleanings.com
# "From" address — must be on a domain verified in Resend. For local testing
# you can use "Chely Cleaning <onboarding@resend.dev>" (only emails the Resend
# account owner). Set a real address like "Chely Cleaning <hello@chelycleaning.com>"
# once the domain is verified.
CONTACT_FROM_EMAIL=

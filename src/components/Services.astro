---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const all = await getCollection('services', ({ data }) => data.lang === lang);
const byOrder = (a: (typeof all)[number], b: (typeof all)[number]) =>
  a.data.order - b.data.order;

const tabs = [
  {
    id: 'residential',
    label: t('services.tabResidential'),
    items: all.filter((s) => s.data.category === 'residential').sort(byOrder),
  },
  {
    id: 'commercial',
    label: t('services.tabCommercial'),
    items: all.filter((s) => s.data.category === 'commercial').sort(byOrder),
  },
];
---

<section id="services" class="relative bg-muted/50 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-gradient-brand">
        {t('services.eyebrow')}
      </span>
      <h2 class="mt-3 text-3xl font-bold text-foreground sm:text-4xl lg:text-5xl">
        {t('services.title')}
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">{t('services.subtitle')}</p>
    </div>

    <div class="mt-10 flex justify-center">
      <div
        class="inline-flex rounded-full border border-border bg-card p-1 shadow-sm"
        role="tablist"
        aria-label={t('services.title')}
      >
        {
          tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${tab.id}`}
              aria-controls={`panel-${tab.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-tab={tab.id}
              class="rounded-full px-6 py-2.5 text-sm font-bold transition-all text-muted-foreground hover:text-primary aria-selected:gradient-brand aria-selected:text-primary-foreground aria-selected:shadow-md aria-selected:shadow-primary/25"
            >
              {tab.label}
            </button>
          ))
        }
      </div>
    </div>

    {
      tabs.map((tab, i) => (
        <div
          id={`panel-${tab.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${tab.id}`}
          data-panel={tab.id}
          hidden={i !== 0}
          class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4"
        >
          {tab.items.map((s) => (
            <article class="group relative overflow-hidden rounded-2xl border border-border bg-card p-6 transition-all hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl hover:shadow-primary/10">
              <div class="absolute right-0 top-0 h-24 w-24 -translate-y-8 translate-x-8 rounded-full bg-secondary/20 blur-2xl transition-opacity group-hover:opacity-70" />
              <div class="relative grid h-12 w-12 place-items-center rounded-xl bg-primary/10 text-2xl">
                <span>{s.data.icon}</span>
              </div>
              <h3 class="relative mt-5 text-lg font-bold text-foreground">{s.data.title}</h3>
              <p class="relative mt-2 text-sm leading-relaxed text-muted-foreground">
                {s.data.description}
              </p>
            </article>
          ))}
        </div>
      ))
    }
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      buttons.forEach((b) =>
        b.setAttribute('aria-selected', String(b.dataset.tab === target)),
      );
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== target;
      });
    });
  });
</script>

---
import { Image } from 'astro:assets';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  label: string;
  beforeLabel: string;
  afterLabel: string;
  hint: string;
}

const { before, after, label, beforeLabel, afterLabel, hint } = Astro.props;
const imgProps = {
  widths: [400, 600, 800],
  sizes: '(min-width: 768px) 45vw, 100vw',
  class: 'absolute inset-0 h-full w-full object-cover',
  loading: 'lazy' as const,
};
---

<div class="rounded-2xl border border-border bg-card p-3 shadow-sm">
  <div
    class="relative aspect-[4/3] w-full cursor-ew-resize select-none overflow-hidden rounded-xl"
    data-bas
    role="slider"
    tabindex="0"
    aria-label={`${label} — ${beforeLabel} / ${afterLabel}`}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
  >
    <Image src={after} alt={`${afterLabel} — ${label}`} {...imgProps} />

    <div class="absolute inset-y-0 left-0 overflow-hidden" data-bas-clip style="width:50%">
      <Image
        src={before}
        alt={`${beforeLabel} — ${label}`}
        {...imgProps}
        class="absolute inset-0 h-full object-cover"
        style="width:200%;max-width:none"
        data-bas-before
      />
    </div>

    <div class="pointer-events-none absolute left-3 top-3 rounded-full bg-black/60 px-2.5 py-1 text-xs font-bold uppercase text-white">
      {beforeLabel}
    </div>
    <div class="pointer-events-none absolute right-3 top-3 rounded-full gradient-brand px-2.5 py-1 text-xs font-bold uppercase text-primary-foreground">
      {afterLabel}
    </div>

    <div
      class="pointer-events-none absolute inset-y-0 w-0.5 bg-white shadow-[0_0_10px_rgba(0,0,0,0.35)]"
      data-bas-divider
      style="left:calc(50% - 1px)"
    >
      <div class="absolute left-1/2 top-1/2 grid h-9 w-9 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-primary shadow-lg">
        ⇄
      </div>
    </div>
  </div>

  <div class="mt-3 flex items-center justify-between px-1">
    <p class="text-sm font-semibold text-foreground">{label}</p>
    <p class="text-xs text-muted-foreground">{hint}</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-bas]').forEach((el) => {
    const clip = el.querySelector<HTMLElement>('[data-bas-clip]');
    const before = el.querySelector<HTMLElement>('[data-bas-before]');
    const divider = el.querySelector<HTMLElement>('[data-bas-divider]');
    if (!clip || !before || !divider) return;

    const set = (pct: number) => {
      const p = Math.max(0, Math.min(100, pct));
      clip.style.width = `${p}%`;
      before.style.width = `${(100 / Math.max(p, 0.01)) * 100}%`;
      divider.style.left = `calc(${p}% - 1px)`;
      el.setAttribute('aria-valuenow', String(Math.round(p)));
    };

    const fromClientX = (clientX: number) => {
      const rect = el.getBoundingClientRect();
      set(((clientX - rect.left) / rect.width) * 100);
    };

    el.addEventListener('pointerdown', (e) => {
      el.setPointerCapture(e.pointerId);
      fromClientX(e.clientX);
    });
    el.addEventListener('pointermove', (e) => {
      if (e.buttons === 1) fromClientX(e.clientX);
    });
    el.addEventListener('keydown', (e) => {
      const now = Number(el.getAttribute('aria-valuenow') || 50);
      if (e.key === 'ArrowLeft') set(now - 4);
      else if (e.key === 'ArrowRight') set(now + 4);
      else if (e.key === 'Home') set(0);
      else if (e.key === 'End') set(100);
    });
  });
</script>

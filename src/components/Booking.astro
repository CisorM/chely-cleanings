---
import { site } from '../config/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const bkSub = site.integrations.bookingKoalaSubdomain;
// Confirm the exact path in BookingKoala → Settings → Booking form → Embed.
const bookingSrc = bkSub ? `https://${bkSub}.bookingkoala.com/booknow/residential` : '';

const rows = [
  { icon: '📍', label: t('contact.locationLabel'), value: t('contact.location') },
  { icon: '📞', label: t('contact.phoneLabel'), value: site.contact.phoneDisplay, href: `tel:${site.contact.phone}` },
  { icon: '✉️', label: t('contact.emailLabel'), value: site.contact.email, href: `mailto:${site.contact.email}` },
  { icon: '🕒', label: t('contact.hoursLabel'), value: t('contact.hours') },
];

const steps = [t('booking.step1'), t('booking.step2'), t('booking.step3')];
---

<section id="booking" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-gradient-brand">
        {t('booking.eyebrow')}
      </span>
      <h2 id="contact" class="mt-3 scroll-mt-24 text-3xl font-bold text-foreground sm:text-4xl lg:text-5xl">
        {t('booking.title')}
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">{t('booking.subtitle')}</p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-[1fr_1.4fr]">
      <!-- Contact card -->
      <div class="rounded-3xl border border-border bg-card p-8 shadow-sm">
        <h3 class="text-xl font-bold text-foreground">{t('contact.title')}</h3>
        <p class="mt-2 text-sm text-muted-foreground">{t('contact.subtitle')}</p>
        <ul class="mt-6 space-y-5">
          {
            rows.map((r) => (
              <li class="flex items-start gap-4">
                <div class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-primary/10 text-lg">
                  <span>{r.icon}</span>
                </div>
                <div class="min-w-0">
                  <div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    {r.label}
                  </div>
                  <div class="text-base font-semibold text-foreground">
                    {r.href ? (
                      <a href={r.href} class="hover:text-primary">{r.value}</a>
                    ) : (
                      r.value
                    )}
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
        <div class="mt-8 rounded-2xl gradient-brand p-5 text-primary-foreground">
          <p class="text-sm font-semibold opacity-90">{t('booking.promoKicker')}</p>
          <p class="mt-1 text-lg font-bold">{t('booking.promoText')}</p>
        </div>
      </div>

      <!-- BookingKoala embed slot -->
      <div class="rounded-3xl border border-border bg-card p-4 shadow-sm sm:p-6">
        <div
          id="bookingkoala-widget"
          class="relative min-h-[520px] w-full overflow-hidden rounded-2xl border-2 border-dashed border-primary/25 bg-muted/60"
        >
          {
            bookingSrc ? (
              <iframe
                src={bookingSrc}
                title="BookingKoala online booking"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="absolute inset-0 h-full w-full"
              />
            ) : (
              <div class="flex min-h-[520px] items-center justify-center p-8 text-center">
                <div>
                  <div class="mx-auto grid h-16 w-16 place-items-center rounded-2xl gradient-brand text-2xl text-primary-foreground shadow-md">
                    📅
                  </div>
                  <h3 class="mt-5 text-xl font-bold text-foreground">
                    {t('booking.widgetFallback')}
                  </h3>
                  <p class="mx-auto mt-2 max-w-md text-sm text-muted-foreground">
                    {t('booking.widgetHint')}
                  </p>
                  <div class="mt-6 flex flex-wrap justify-center gap-2">
                    {steps.map((s, i) => (
                      <div class="flex items-center gap-2 rounded-full border border-border bg-background px-3 py-1.5 text-xs font-semibold text-foreground">
                        <span class="grid h-5 w-5 place-items-center rounded-full gradient-brand text-[10px] text-primary-foreground">
                          {i + 1}
                        </span>
                        {s}
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

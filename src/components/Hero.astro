---
import { Image } from 'astro:assets';
import heroImg from '../assets/hero-clean.jpg';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stats = [
  { n: t('hero.stat1Num'), l: t('hero.stat1Label') },
  { n: t('hero.stat2Num'), l: t('hero.stat2Label') },
  { n: t('hero.stat3Num'), l: t('hero.stat3Label') },
];
---

<section id="home" class="relative overflow-hidden pt-28 pb-20 sm:pt-36 sm:pb-28">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -left-24 -top-24 h-96 w-96 rounded-full bg-primary/20 blur-3xl"></div>
    <div class="absolute -right-24 top-40 h-96 w-96 rounded-full bg-secondary/25 blur-3xl"></div>
  </div>

  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-4 sm:px-6 lg:grid-cols-2">
    <div class="max-w-xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary">
        <span class="h-1.5 w-1.5 rounded-full bg-secondary"></span>
        {t('hero.badge')}
      </span>

      <h1 class="mt-5 text-4xl font-bold leading-[1.05] text-foreground sm:text-5xl lg:text-6xl">
        <span class="text-gradient-brand">{t('hero.headlineA')}</span>
        <br />
        {t('hero.headlineB')}
      </h1>

      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
        {t('hero.subheadline')}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#booking"
          class="inline-flex items-center justify-center rounded-full gradient-brand px-7 py-3.5 text-base font-bold text-primary-foreground shadow-lg shadow-primary/30 transition-transform hover:scale-[1.03]"
        >
          {t('hero.ctaPrimary')}
        </a>
        <a
          href="#services"
          class="inline-flex items-center justify-center rounded-full border-2 border-primary/20 bg-background px-7 py-3.5 text-base font-bold text-primary transition-colors hover:bg-primary/5"
        >
          {t('hero.ctaSecondary')}
        </a>
      </div>

      <div class="mt-10 grid grid-cols-3 gap-4 border-t border-border pt-6 text-left">
        {
          stats.map((s) => (
            <div>
              <div class="text-2xl font-bold text-primary sm:text-3xl">{s.n}</div>
              <div class="text-xs text-muted-foreground sm:text-sm">{s.l}</div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="relative">
      <div class="absolute -inset-4 -z-10 rounded-[2rem] gradient-brand opacity-25 blur-2xl"></div>
      <div class="overflow-hidden rounded-[2rem] border border-border bg-card shadow-2xl shadow-primary/20">
        <Image
          src={heroImg}
          alt={t('hero.imageAlt')}
          class="h-full w-full object-cover"
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 512px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="absolute -bottom-6 -left-6 hidden rounded-2xl border border-border bg-card px-4 py-3 shadow-lg sm:flex sm:items-center sm:gap-3">
        <div class="grid h-10 w-10 place-items-center rounded-full gradient-brand text-primary-foreground">
          ✓
        </div>
        <div>
          <div class="text-sm font-bold text-foreground">{t('hero.badgeInsuredTitle')}</div>
          <div class="text-xs text-muted-foreground">{t('hero.badgeInsuredSub')}</div>
        </div>
      </div>
    </div>
  </div>
</section>

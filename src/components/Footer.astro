---
import Logo from './Logo.astro';
import { site } from '../config/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const links = [
  ['#home', t('nav.home')],
  ['#about', t('nav.about')],
  ['#services', t('nav.services')],
  ['#gallery', t('nav.gallery')],
  ['#booking', t('nav.cta')],
];

// Placeholder social handles — wire real URLs in src/config/site.ts.
const socials: { label: string; href: string }[] = [
  { label: 'F', href: site.social.facebook },
  { label: 'I', href: site.social.instagram },
  { label: 'in', href: site.social.google },
].filter((s) => s.href) as { label: string; href: string }[];
const socialsFallback = [{ label: 'F' }, { label: 'I' }, { label: 'X' }, { label: 'in' }];
---

<footer class="border-t border-border bg-muted/40">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div data-reveal>
        <div class="flex items-center gap-3">
          <Logo variant="icon" class="h-12 w-12" loading="lazy" />
          <div>
            <div class="text-lg font-bold text-foreground">{t('site.shortName')}</div>
            <div class="text-xs text-muted-foreground">{t('footer.entity')}</div>
          </div>
        </div>
        <p class="mt-4 max-w-sm text-sm text-muted-foreground">{t('footer.blurb')}</p>
      </div>

      <div data-reveal style="--reveal-delay:100ms">
        <h4 class="text-sm font-bold uppercase tracking-wider text-foreground">
          {t('footer.explore')}
        </h4>
        <ul class="mt-4 space-y-2 text-sm">
          {
            links.map(([href, label]) => (
              <li>
                <a href={href} class="text-muted-foreground hover:text-primary">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal style="--reveal-delay:200ms">
        <h4 class="text-sm font-bold uppercase tracking-wider text-foreground">
          {t('footer.follow')}
        </h4>
        <div class="mt-4 flex gap-3">
          {
            (socials.length ? socials : socialsFallback).map((s) => (
              <a
                href={'href' in s ? s.href : '#'}
                aria-label={`Social ${s.label}`}
                target={'href' in s ? '_blank' : undefined}
                rel={'href' in s ? 'noopener noreferrer me' : undefined}
                class="grid h-10 w-10 place-items-center rounded-full border border-border bg-background text-sm font-bold text-primary transition-colors hover:border-transparent hover:gradient-brand hover:text-primary-foreground"
              >
                {s.label}
              </a>
            ))
          }
        </div>
        <p class="mt-4 text-sm text-muted-foreground">
          {t('contact.location')} · {site.contact.email}
        </p>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center">
      <p>© {year} {t('site.name')}. {t('footer.rights')}</p>
      <p>{t('footer.madeWith')}</p>
    </div>
  </div>
</footer>
